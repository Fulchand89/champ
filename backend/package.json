{
  "name": "quiz-app-backend",
  "version": "1.0.0",
  "description": "Quiz App backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "migrate:undo:all": "npx sequelize-cli db:migrate:undo:all",
    "seed": "npx sequelize-cli db:seed:all",
    "seed:undo": "npx sequelize-cli db:seed:undo",
    "seed:undo:all": "npx sequelize-cli db:seed:undo:all",
    "db:refresh": "npm run migrate:undo:all && npm run migrate && npm run seed"
  },
  "keywords": [
    "mysql",
    "express",
    "node"
  ],
  "author": "Gupta Tech web",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "firebase-admin": "^14.1.0",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.1.1",
    "mysql2": "^3.22.5",
    "nanoid": "^3.3.12",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.0",
    "pdfkit": "^0.19.1",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.1",
    "socket.io": "^4.8.3",
    "stripe": "^22.3.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "^2.0.10",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
